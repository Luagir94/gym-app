{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": "../tsconfig.jest.json"
    }]
  },
  "moduleNameMapper": {
    "^@gym/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  }
}
